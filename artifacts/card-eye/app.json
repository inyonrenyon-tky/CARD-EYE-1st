{
  "expo": {
    "name": "CARD EYE",
    "slug": "card-eye",
    "owner": "sekkekkyu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/classic-icon.png",
    "backgroundColor": "#061943",
    "scheme": "card-eye",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.cardeye.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.cardeye.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/classic-icon.png",
        "backgroundColor": "#061943"
      }
    },
    "web": {
      "favicon": "./assets/images/classic-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/classic-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#061943"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CARD EYEがカードを撮影するためにカメラを使用します。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
